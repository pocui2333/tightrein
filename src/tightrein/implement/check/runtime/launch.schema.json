{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "项目启动脚本输出的本机启动计划",
  "type": "object",
  "required": ["services", "unavailable", "migrationPaths"],
  "additionalProperties": false,
  "properties": {
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "cwd", "argv", "env", "port", "after", "readyPatterns", "failPatterns", "readyUrl"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "role": {"enum": ["api", "pages", null]},
          "cwd": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "after": {"type": ["string", "null"]},
          "readyPatterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "failPatterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "readyUrl": {"type": ["string", "null"]}
        }
      }
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "migrationPaths": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
