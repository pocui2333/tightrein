{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "截图审查的结论(implement.check.screenshots)",
  "type": "object",
  "required": ["analysis", "screenshots"],
  "additionalProperties": false,
  "properties": {
    "analysis": {"type": "string", "minLength": 1},
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "result", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "result": {"enum": ["ok", "issue", "unknown"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
