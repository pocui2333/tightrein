{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/assess/assess.dedup.schema.json",
  "title": "评估的查重(assess.dedup)",
  "type": "object",
  "required": [
    "sameRootCause",
    "target",
    "evidence",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "sameRootCause": {
      "type": "boolean"
    },
    "target": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(P-)?\\d{4,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^:\\s][^:]*:\\d+(-\\d+)?$"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "sameRootCause": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "target": {
        "type": "string"
      },
      "evidence": {
        "minItems": 1
      }
    }
  }
}
