{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/assess/assess.triage.schema.json",
  "title": "评估的取证结论(assess.triage；证伪复核 assess.refute 用同一格式)",
  "type": "object",
  "required": [
    "analysis",
    "verdict",
    "facts",
    "trigger",
    "counterEvidence",
    "impact",
    "sourceOfPhenomenon",
    "rootCauses",
    "fixedOnMain",
    "tradeoffHit",
    "missingInfo",
    "incidental",
    "report",
    "assessment",
    "notes",
    "knowledgeSuggestions"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "type": "string",
      "minLength": 1,
      "description": "先写：读了什么、调用链怎么走、为什么这样判"
    },
    "verdict": {
      "enum": [
        "confirmed",
        "conditional",
        "refuted",
        "insufficient"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counterEvidence"
      }
    },
    "impact": {
      "anyOf": [
        {
          "$ref": "#/$defs/impact"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceOfPhenomenon": {
      "anyOf": [
        {
          "$ref": "#/$defs/sourceOfPhenomenon"
        },
        {
          "type": "null"
        }
      ]
    },
    "rootCauses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rootCause"
      }
    },
    "fixedOnMain": {
      "anyOf": [
        {
          "$ref": "#/$defs/fixedOnMain"
        },
        {
          "type": "null"
        }
      ]
    },
    "tradeoffHit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(CON|PAT|LES)-\\d{4,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "missingInfo": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missingInfo"
      }
    },
    "incidental": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/incidental"
      }
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/report"
        },
        {
          "type": "null"
        }
      ]
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/assessment"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      },
      "description": "读到的、后面的步骤还会用到的位置(代码笔记)"
    },
    "knowledgeSuggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "建议沉淀进知识库的规律，交用户确认"
    }
  },
  "$defs": {
    "location": {
      "type": "string",
      "pattern": "^[^:\\s][^:]*:\\d+(-\\d+)?$"
    },
    "fact": {
      "type": "object",
      "required": [
        "location",
        "observation"
      ],
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/location"
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counterEvidence": {
      "type": "object",
      "required": [
        "check",
        "entry",
        "upstreamValidation",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "upstreamValidation": {
          "type": "object",
          "required": [
            "status",
            "location"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "present",
                "absent"
              ]
            },
            "location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "kind",
        "roles",
        "data",
        "callSites",
        "consequence"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "authorization",
            "data-ownership",
            "data-correctness",
            "credential-leak",
            "core-flow-broken",
            "non-core-error",
            "contract-mismatch",
            "experience",
            "slow-response",
            "dependency-vulnerability"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "type": "string"
        },
        "callSites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "consequence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceOfPhenomenon": {
      "type": "object",
      "required": [
        "location",
        "factRef",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "factRef": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rootCause": {
      "type": "object",
      "required": [
        "file",
        "line",
        "symbol"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fixedOnMain": {
      "type": "object",
      "required": [
        "commit",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "missingInfo": {
      "type": "object",
      "required": [
        "item",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "code",
            "user"
          ]
        }
      }
    },
    "incidental": {
      "type": "object",
      "required": [
        "file",
        "line",
        "symbol",
        "category",
        "confidence",
        "evidence",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "文件路径，相对仓库根",
          "examples": [
            "src/Services/RefundService.cs"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "行号；不确定时为 null(不参与指纹)"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "函数或方法名(类名.方法名)；不在函数里时为 null",
          "examples": [
            "RefundService.Retry"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "类别：defect(缺陷)、security(安全)、performance(性能)、data(数据)；命名、风格、重构建议等其他类别不收",
          "examples": [
            "defect"
          ]
        },
        "confidence": {
          "enum": [
            "confirmed",
            "suspected"
          ],
          "description": "把握程度：confirmed(确定，看到了代码证据)、suspected(疑似)"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "一句证据：看到了什么代码或行为",
          "examples": [
            "Retry() 重试成功后没有把 ManualReview 置回 false"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "发现的原文：一句话写现象",
          "examples": [
            "退款重试后不清除人工复核标记"
          ]
        }
      },
      "description": "任务外发现：与本主张无关、途中撞见的缺陷(结构与 collect/incidental/finding.schema.json 相同)"
    },
    "report": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "steps",
        "expected",
        "actual",
        "acceptance",
        "severity",
        "severityReason"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "severityReason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "flag": {
      "type": "object",
      "required": [
        "flagged",
        "reason",
        "locations"
      ],
      "additionalProperties": false,
      "properties": {
        "flagged": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "worth",
        "worthReason",
        "taskType",
        "size",
        "files",
        "direction",
        "flags",
        "reevaluateWhen",
        "outOfScope",
        "mustKeep"
      ],
      "additionalProperties": false,
      "properties": {
        "worth": {
          "enum": [
            "fix",
            "optional",
            "defer",
            "wont"
          ]
        },
        "worthReason": {
          "type": "string",
          "minLength": 1
        },
        "taskType": {
          "enum": [
            "bug",
            "security",
            "data",
            "frontend",
            "feature",
            "refactor",
            "dependency",
            "docs-config"
          ]
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "description": "粗规模档，只用于分流"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "isNew"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "isNew": {
                "type": "boolean"
              }
            }
          }
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "object",
          "required": [
            "design",
            "dataStructure",
            "publicContract"
          ],
          "additionalProperties": false,
          "properties": {
            "design": {
              "$ref": "#/$defs/flag"
            },
            "dataStructure": {
              "$ref": "#/$defs/flag"
            },
            "publicContract": {
              "$ref": "#/$defs/flag"
            }
          }
        },
        "reevaluateWhen": {
          "type": [
            "string",
            "null"
          ]
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mustKeep": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "note": {
      "type": "object",
      "required": [
        "location",
        "description",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/location"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "core",
            "related"
          ]
        }
      }
    }
  }
}
