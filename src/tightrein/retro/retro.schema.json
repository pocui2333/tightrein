{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retro.schema.json",
  "title": "retro.detect 交接的必填事实：新建与追加的记录、各自评级",
  "type": "object",
  "additionalProperties": false,
  "required": ["created", "appended", "errors"],
  "properties": {
    "created": {"$ref": "#/$defs/records"},
    "appended": {"$ref": "#/$defs/records"},
    "errors": {"type": "array", "items": {"type": "string"}, "description": "检测与写解决思路时出的错；不影响其余各项"}
  },
  "$defs": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rating", "kind", "point", "count"],
        "properties": {
          "id": {"type": "string", "pattern": "^\\d{4,}$"},
          "rating": {"enum": ["P0", "P1", "P2", "P3"]},
          "kind": {"enum": ["failure", "waste", "misjudgment", "interruption"]},
          "point": {"type": "string"},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
