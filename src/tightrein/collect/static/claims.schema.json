{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/collect/static/claims.schema.json",
  "title": "静态巡检的增量审查、基线审查与变体扫描输出的候选主张",
  "type": "object",
  "required": ["claims", "excluded"],
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "ruleOrPattern", "layer", "severity", "statement", "trigger"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "ruleOrPattern": {"type": "string", "minLength": 1},
          "layer": {"enum": ["deterministic", "incremental", "full", "baseline"]},
          "severity": {"enum": ["high", "medium", "low"]},
          "statement": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1}
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "statement", "tradeoffId"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "statement": {"type": "string", "minLength": 1},
          "tradeoffId": {"type": "string", "pattern": "^(CON|PAT|LES)-\\d{4,}$"}
        }
      }
    }
  }
}
