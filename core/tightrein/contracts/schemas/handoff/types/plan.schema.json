{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/handoff/types/plan.schema.json",
  "title": "plan：修复或实现计划",
  "description": "plan 类型交接文档的数据块：每个 $defs 项是一个标签为 data:<名称> 的 YAML 代码块",
  "$defs": {
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "「文件与步骤」小节中计划改动的文件清单",
      "items": {
        "type": "object",
        "required": [
          "path",
          "change"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "相对仓库根目录的文件路径",
            "examples": [
              "src/api/orders.py"
            ]
          },
          "change": {
            "enum": [
              "add",
              "modify",
              "delete"
            ],
            "description": "改动方式",
            "examples": [
              "modify"
            ]
          },
          "reason": {
            "type": "string",
            "description": "为什么要改这个文件",
            "examples": [
              "补上数据归属校验"
            ]
          }
        }
      }
    }
  }
}
