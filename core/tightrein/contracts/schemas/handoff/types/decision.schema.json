{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/handoff/types/decision.schema.json",
  "title": "decision：请求用户或上级拍板",
  "description": "decision 类型交接文档的数据块：每个 $defs 项是一个标签为 data:<名称> 的 YAML 代码块",
  "$defs": {
    "options": {
      "type": "array",
      "minItems": 1,
      "description": "「选项及利弊」小节中可供选择的选项",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "recommended"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "选项编号，用户的选择按它记录",
            "examples": [
              "split"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "一句话说明这个选项",
            "examples": [
              "拆成两个子 Issue 依次修复"
            ]
          },
          "recommended": {
            "type": "boolean",
            "description": "是否为推荐选项；最多一个为 true",
            "examples": [
              true
            ]
          }
        }
      }
    }
  }
}
