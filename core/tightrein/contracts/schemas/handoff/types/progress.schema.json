{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/handoff/types/progress.schema.json",
  "title": "progress：长任务的进展",
  "description": "progress 类型交接文档的数据块：每个 $defs 项是一个标签为 data:<名称> 的 YAML 代码块",
  "$defs": {
    "checklist": {
      "type": "array",
      "minItems": 1,
      "description": "「检查清单」小节中的各项工作",
      "items": {
        "type": "object",
        "required": [
          "item",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "description": "一项工作",
            "examples": [
              "建修复分支与 worktree"
            ]
          },
          "state": {
            "enum": [
              "pending",
              "done",
              "blocked",
              "failed"
            ],
            "description": "这一项的状态",
            "examples": [
              "done"
            ]
          },
          "owner": {
            "enum": [
              "system",
              "user"
            ],
            "description": "由系统自动完成还是需要用户处理",
            "examples": [
              "system"
            ]
          }
        }
      }
    }
  }
}
