{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/data/problem.schema.json",
  "title": "问题",
  "type": "object",
  "required": [
    "id",
    "fingerprint",
    "fingerprintVersion",
    "probe",
    "title",
    "status",
    "firstSeenAt",
    "lastSeenAt",
    "scope",
    "firstSeenRelease",
    "lastSeenRelease",
    "resolvedRelease",
    "occurrences",
    "issueId",
    "ignoreUntil",
    "intermittent",
    "cleanCoveredRuns",
    "mergedInto"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "../common.schema.json#/$defs/problemId"},
    "fingerprint": {"$ref": "../common.schema.json#/$defs/fingerprint"},
    "fingerprintVersion": {"type": "integer", "minimum": 1},
    "probe": {"$ref": "../common.schema.json#/$defs/Probe"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {"$ref": "../common.schema.json#/$defs/ProblemStatus"},
    "firstSeenAt": {"$ref": "../common.schema.json#/$defs/timestamp"},
    "lastSeenAt": {"$ref": "../common.schema.json#/$defs/timestamp"},
    "scope": {"$ref": "../common.schema.json#/$defs/problemScope"},
    "firstSeenRelease": {"type": ["string", "null"]},
    "lastSeenRelease": {"type": ["string", "null"]},
    "resolvedRelease": {"type": ["string", "null"]},
    "occurrences": {"type": "integer", "minimum": 1},
    "issueId": {"anyOf": [{"$ref": "../common.schema.json#/$defs/issueId"}, {"type": "null"}]},
    "ignoreUntil": {"anyOf": [{"$ref": "../common.schema.json#/$defs/ignoreCondition"}, {"type": "null"}]},
    "intermittent": {"type": "boolean"},
    "cleanCoveredRuns": {"type": "integer", "minimum": 0},
    "mergedInto": {"anyOf": [{"$ref": "../common.schema.json#/$defs/problemId"}, {"type": "null"}]}
  }
}
