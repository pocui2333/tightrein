{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/config/user-config.schema.json",
  "title": "本机用户配置 ~/.config/tightrein/config.yaml(architecture/01 5.3)：只允许个人键与 agent 工具、网络代理的个人设置",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "branchPrefix": {
      "$ref": "#/$defs/text"
    },
    "defaultWorkspace": {
      "$ref": "#/$defs/text"
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "macos",
            "none"
          ]
        }
      }
    },
    "tools": {
      "description": "各工具的可执行文件路径；tools.semgrep.path 覆盖 runtime.tools.semgrep，含 / 的相对路径相对本工具仓库根目录，例如 local/semgrep/bin/semgrep(本机依赖放在 local/)",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "$ref": "#/$defs/text"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxy": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://\\S+$"
        },
        "noProxy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "models": {
      "$ref": "project-config.schema.json#/properties/models"
    },
    "routes": {
      "$ref": "project-config.schema.json#/properties/routes"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
