{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/extension/points/static-tools.input.schema.json",
  "title": "static-tools 的 input",
  "type": "object",
  "required": ["level", "baseCommit", "changedFiles", "rawDir"],
  "additionalProperties": false,
  "properties": {
    "level": {"enum": ["incremental", "full"]},
    "baseCommit": {"anyOf": [{"$ref": "../../common.schema.json#/$defs/commit"}, {"type": "null"}]},
    "changedFiles": {"type": "array", "items": {"$ref": "../extension-request.schema.json#/$defs/relativePath"}},
    "rawDir": {"$ref": "../extension-request.schema.json#/$defs/absolutePath"}
  },
  "if": {"properties": {"level": {"const": "incremental"}}},
  "then": {"properties": {"baseCommit": {"$ref": "../../common.schema.json#/$defs/commit"}}}
}
