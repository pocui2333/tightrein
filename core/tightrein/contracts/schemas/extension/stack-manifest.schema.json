{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tightrein.local/schemas/extension/stack-manifest.schema.json",
  "title": "技术栈扩展的清单 stack.yaml",
  "type": "object",
  "required": ["name", "version"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "minVersion"],
        "additionalProperties": false,
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "minVersion": {"type": "string", "minLength": 1},
          "install": {"type": ["string", "null"]}
        }
      }
    },
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "defaults": {
      "type": "object",
      "propertyNames": {"$ref": "../common.schema.json#/$defs/ExtensionPoint"},
      "additionalProperties": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    }
  }
}
